# Postgres connection string. On Railway, reference the Postgres service: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:password@localhost:5432/papaspuzzles
# Optional: force SSL on/off (defaults: off for *.railway.internal/localhost, on otherwise)
# DATABASE_SSL=false

# Long random string used to sign login session cookies (e.g. `openssl rand -hex 32`)
SESSION_SECRET=

# Directory for uploaded puzzle photos. On Railway, mount a volume and point this inside it.
UPLOAD_DIR=./uploads

# Public URL of the app, used in password reset emails (e.g. https://papaspuzzles.up.railway.app)
APP_URL=http://localhost:3000

# Optional: transactional email via Resend. Without a key, reset emails are logged to the console.
# RESEND_API_KEY=
# EMAIL_FROM="Papa's Puzzles <no-reply@yourdomain.com>"
