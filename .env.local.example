# Postgres connection string. On Railway, reference the Postgres service: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:pp@localhost:5433/papaspuzzles
# Optional: force SSL on/off (defaults: off for *.railway.internal/localhost, on otherwise)
DATABASE_SSL=false

# Long random string used to sign login session cookies (e.g. `openssl rand -hex 32`)
SESSION_SECRET=

# Comma-separated emails whose accounts get the admin area
ADMIN_EMAILS=founder@example.com

# Directory for uploaded puzzle photos. On Railway, mount a volume and point this inside it (/data/uploads).
UPLOAD_DIR=./uploads

# Public URL of the app, used in password reset emails. Required in production.
APP_URL=http://localhost:3000

# Optional: transactional email via Resend. Without a key, reset links are printed to the server log.
# RESEND_API_KEY=
# EMAIL_FROM="Papa's Puzzles <no-reply@papaspuzzles.org>"
