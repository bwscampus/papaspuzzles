{
    "name": "papaspuzzles",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "node scripts/migrate.mjs && next start",
        "lint": "eslint .",
        "migrate": "node scripts/migrate.mjs",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "check": "npm run typecheck && npm run lint && npm run test"
    },
    "dependencies": {
        "heic-convert": "^2.1.0",
        "jose": "^6.1.3",
        "lucide-react": "^0.378.0",
        "next": "15.3.9",
        "pg": "^8.23.0",
        "react": "^18",
        "react-dom": "^18"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.7",
        "@types/heic-convert": "^2.1.0",
        "@types/node": "^22.20.1",
        "@types/pg": "^8.23.1",
        "@types/react": "^18",
        "@types/react-dom": "^18",
        "autoprefixer": "^10.4.22",
        "eslint": "^9.39.5",
        "eslint-config-next": "^15.3.9",
        "postcss": "^8",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^3.4.1",
        "typescript": "^5",
        "vitest": "^5.0.0"
    },
    "engines": {
        "node": ">=20"
